---
layout: layout.njk
permalink: /about/
title: About
fullScreen: false
hideFooter: false
pageStyles: |
  .about {
    max-width: 720px;
    margin: 64px auto;
    padding: 0 var(--pad);
    flex: 1;
  }
  .about h2 { font-size: 14px; font-weight: 700; line-height: 1.9; margin-top: 40px; margin-bottom: 6px; }
  .about h2:first-child { margin-top: 0; }
  .about p { margin-bottom: 14px; }
  .about ul { list-style: none; padding: 0; }
  .about li { display: grid; grid-template-columns: 64px 1fr; gap: 16px; padding: 2px 0; align-items: baseline; }
  .about li .year { color: var(--fg-dim); }
  body { font-size: 14px; line-height: 1.9; }
  .logo, .header-meta { font-size: 14px; line-height: 1.9; }
  @media (max-width: 640px) {
    .about { margin: 32px 0; padding: 0; max-width: 100%; }
    .about h2 { font-size: 12px; line-height: 1.6; margin-top: 32px; }
    .about li { grid-template-columns: 52px 1fr; gap: 10px; }
    body { font-size: 12px; line-height: 1.6; }
    .logo, .header-meta { font-size: 12px; line-height: 1.6; }
    .footer { margin-top: 32px; }
  }
---
<main class="about">

  <h2>Bio</h2>
  {% for paragraph in about.bio.split('\n\n') %}
  <p>{{ paragraph | trim }}</p>
  {% endfor %}

  {% if about.awards_grants and about.awards_grants.length > 0 %}
  <h2>Awards &amp; Grants</h2>
  <ul>
    {% for item in about.awards_grants %}
    <li><span class="year">{{ item.year }}</span><span>{{ item.detail }}</span></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if about.solo_exhibitions and about.solo_exhibitions.length > 0 %}
  <h2>Solo Exhibitions</h2>
  <ul>
    {% for item in about.solo_exhibitions %}
    <li><span class="year">{{ item.year }}</span><span>{{ item.detail }}</span></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if about.selected_exhibitions and about.selected_exhibitions.length > 0 %}
  <h2>Selected Exhibitions</h2>
  <ul>
    {% for item in about.selected_exhibitions %}
    <li><span class="year">{{ item.year }}</span><span>{{ item.detail }}</span></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if about.publications and about.publications.length > 0 %}
  <h2>Publications</h2>
  <ul>
    {% for item in about.publications %}
    <li><span class="year">{{ item.year }}</span><span>{{ item.detail }}</span></li>
    {% endfor %}
  </ul>
  {% endif %}

  <h2>Contact</h2>
  <p>
    <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
    <a href="{{ site.instagram }}" target="_blank" rel="noopener">@jiatonglu_</a>
  </p>

</main>
