---
layout: layout.njk
fullScreen: true
hideFooter: true
pageStyles: |
  .gallery {
    flex: 1;
    display: flex; flex-direction: row;
    align-items: center;
    overflow-x: auto; overflow-y: hidden;
    gap: 24px;
    padding: var(--pad) 0;
    scroll-behavior: smooth;
  }
  .gallery::-webkit-scrollbar { height: 6px; }
  .gallery::-webkit-scrollbar-track { background: transparent; }
  .gallery::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
  .gallery > * { flex-shrink: 0; }
  .image-panel {
    height: 67%;
    display: flex; align-items: center;
  }
  .image-panel img {
    height: 100%;
    width: auto; max-width: none;
    display: block; object-fit: contain;
  }
  .text-panel {
    width: 520px; height: 67%;
    display: flex; flex-direction: column; justify-content: center;
    padding: 0 36px;
    font-size: 12px; line-height: 1.75;
    overflow-y: auto;
  }
  .text-panel p { margin-bottom: 14px; }
  .text-panel p:last-child { margin-bottom: 0; }
  .text-panel blockquote {
    margin-top: 20px;
    font-style: italic;
    text-align: center;
  }
  .scroll-hint {
    position: fixed;
    bottom: var(--pad); right: var(--pad);
    font-size: 11px; color: var(--fg-dim);
    letter-spacing: 0.05em;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  @media (max-width: 640px) {
    .gallery {
      flex-direction: column; align-items: stretch;
      overflow: visible; padding: 24px 0; gap: 28px;
    }
    .image-panel { height: auto; width: 100%; }
    .image-panel img { width: 100%; height: auto; max-width: 100%; }
    .text-panel {
      width: 100%; height: auto;
      padding: 8px 0 12px;
      font-size: 12px; line-height: 1.6;
    }
    .scroll-hint { display: none; }
  }
pageScripts: |
  const gallery = document.querySelector('.gallery');
  const hint = document.querySelector('.scroll-hint');
  if (window.matchMedia('(min-width: 641px)').matches) {
    gallery.addEventListener('wheel', (e) => {
      if (e.deltaY === 0) return;
      e.preventDefault();
      gallery.scrollBy({ left: e.deltaY * 1.5, behavior: 'auto' });
    }, { passive: false });
    let hidden = false;
    gallery.addEventListener('scroll', () => {
      if (hidden) return;
      if (gallery.scrollLeft > 80) { hint.style.opacity = '0'; hidden = true; }
    });
  }
---
<main class="gallery">

  {% for block in blocks %}
    {% if block.type == "image" %}
    <figure class="image-panel">
      {% responsiveImage block.image, block.alt or title, "(max-width: 640px) 100vw, 70vw", 1280, "lazy" if not loop.first else "eager", "", { fetchpriority: "high" if loop.first else "auto" } %}
    </figure>
    {% elif block.type == "text" %}
    <section class="text-panel">
      {{ block.text_html | safe }}
    </section>
    {% endif %}
  {% endfor %}

</main>

<div class="scroll-hint">Scroll →</div>
