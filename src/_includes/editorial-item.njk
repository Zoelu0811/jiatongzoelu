---
layout: layout.njk
fullScreen: true
hideFooter: true
pageStyles: |
  .gallery {
    flex: 1;
    display: flex; flex-direction: row;
    align-items: center;
    overflow-x: auto; overflow-y: hidden;
    gap: 48px;
    padding: var(--pad) 0;
    scroll-behavior: smooth;
  }
  .gallery::-webkit-scrollbar { height: 6px; }
  .gallery::-webkit-scrollbar-track { background: transparent; }
  .gallery::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
  .group {
    flex-shrink: 0;
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 12px;
    height: calc(60vh + 100px);
  }
  .gallery .group:only-child { margin: auto; }
  .stage { position: relative; height: 60vh; cursor: pointer; }
  .group:not(.multi) .stage { cursor: default; }
  .stage img {
    display: block; height: 100%;
    width: auto; max-width: none;
    object-fit: contain;
  }
  .counter {
    font-size: 11px; color: var(--fg-dim);
    letter-spacing: 0.05em;
    min-height: 18px;
  }
  .group:not(.multi) .counter { visibility: hidden; }
  .caption {
    width: 100%; max-width: 360px;
    font-size: 12px; line-height: 1.6; color: var(--fg);
  }
  .caption .title { font-weight: 700; margin-bottom: 4px; }
  .caption p { margin-bottom: 8px; }
  .caption p:last-child { margin-bottom: 0; }
  .scroll-hint {
    position: fixed;
    bottom: var(--pad); right: var(--pad);
    font-size: 11px; color: var(--fg-dim);
    letter-spacing: 0.05em;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  @media (max-width: 640px) {
    .gallery {
      flex-direction: column; align-items: stretch;
      overflow: visible; padding: 24px 0; gap: 40px;
    }
    .group {
      height: auto; width: 100%;
      flex-direction: column-reverse;
    }
    .gallery .group:only-child { margin: 0; }
    .stage { height: auto; }
    .stage img { height: auto; width: 100%; max-width: 100%; }
    .caption { max-width: 100%; }
    .scroll-hint { display: none; }
  }
pageScripts: |
  document.querySelectorAll('.group').forEach(group => {
    const imgs = JSON.parse(group.dataset.images);
    if (imgs.length > 1) group.classList.add('multi');
    const stage = group.querySelector('.stage');
    const imgEl = stage.querySelector('img');
    const webpSource = stage.querySelector('source[type="image/webp"]');
    const cur = group.querySelector('.cur');
    let i = 0;
    function show(idx) {
      i = (idx + imgs.length) % imgs.length;
      const img = imgs[i];
      if (webpSource && img.webpSrcset) {
        webpSource.srcset = img.webpSrcset;
        webpSource.sizes = img.sizes || '';
      } else if (webpSource) {
        webpSource.removeAttribute('srcset');
        webpSource.removeAttribute('sizes');
      }
      if (img.srcset) {
        imgEl.srcset = img.srcset;
        imgEl.sizes = img.sizes || '';
      } else {
        imgEl.removeAttribute('srcset');
        imgEl.removeAttribute('sizes');
      }
      imgEl.src = img.src;
      cur.textContent = i + 1;
    }
    if (imgs.length > 1) stage.addEventListener('click', () => show(i + 1));
  });
  const gallery = document.querySelector('.gallery');
  const hint = document.querySelector('.scroll-hint');
  if (window.matchMedia('(min-width: 641px)').matches) {
    gallery.addEventListener('wheel', (e) => {
      if (e.deltaY === 0) return;
      e.preventDefault();
      gallery.scrollBy({ left: e.deltaY * 1.5, behavior: 'auto' });
    }, { passive: false });
    let hidden = false;
    gallery.addEventListener('scroll', () => {
      if (hidden) return;
      if (gallery.scrollLeft > 80) { hint.style.opacity = '0'; hidden = true; }
    });
  }
---
<main class="gallery">

  {% for group in groups %}
  <article class="group" data-images='{{ group.images | responsiveImageList(1280, "(max-width: 640px) 100vw, 70vw") | jsonStringify | safe }}'>
    <div class="stage">{% responsiveImage group.images[0], group.title, "(max-width: 640px) 100vw, 70vw", 1280, "lazy" if not loop.first else "eager", "", { fetchpriority: "high" if loop.first else "auto" } %}</div>
    <div class="counter"><span class="cur">1</span> / <span class="tot">{{ group.images.length }}</span></div>
    <div class="caption">
      <div class="title">{{ group.title }}</div>
      {% if group.description %}<p>{{ group.description }}</p>{% endif %}
    </div>
  </article>
  {% endfor %}

</main>

<div class="scroll-hint">Scroll →</div>
