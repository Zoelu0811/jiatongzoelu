---
layout: layout.njk
fullScreen: true
hideFooter: true
pageStyles: |
  .projects {
    flex: 1;
    display: flex; flex-direction: row;
    align-items: center;
    overflow-x: auto; overflow-y: hidden;
    gap: 48px;
    padding: var(--pad) 0;
    scroll-behavior: smooth;
  }
  .projects::-webkit-scrollbar { height: 6px; }
  .projects::-webkit-scrollbar-track { background: transparent; }
  .projects::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
  .project {
    flex-shrink: 0;
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 12px;
  }
  .project .thumb {
    height: 60vh;
    background: #ececec;
    overflow: hidden;
  }
  .project img {
    display: block;
    height: 100%; width: auto; max-width: none;
    object-fit: contain;
    transition: opacity 0.25s ease;
  }
  .project a:hover img { opacity: 0.85; }
  .project .caption { font-size: 12px; line-height: 1.6; }
  .scroll-hint {
    position: fixed;
    bottom: var(--pad); right: var(--pad);
    font-size: 11px; color: var(--fg-dim);
    letter-spacing: 0.05em;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  body { font-size: 12px; line-height: 1.6; }
  .logo, .header-meta { font-size: 14px; line-height: 1.9; }
  @media (max-width: 640px) {
    .projects {
      overflow-x: auto; overflow-y: hidden;
      align-items: center;
      gap: 24px;
      padding: 24px 0 42px;
    }
    .project .thumb { height: 56vh; }
    .project .caption { font-size: 12px; line-height: 1.6; }
    .logo, .header-meta { font-size: 12px; line-height: 1.6; }
    .scroll-hint { display: none; }
  }
pageScripts: |
  const projects = document.querySelector('.projects');
  const hint = document.querySelector('.scroll-hint');
  projects.addEventListener('wheel', (e) => {
    if (e.deltaY === 0) return;
    e.preventDefault();
    projects.scrollBy({ left: e.deltaY * 1.5, behavior: 'auto' });
  }, { passive: false });
  let hidden = false;
  projects.addEventListener('scroll', () => {
    if (hidden) return;
    if (projects.scrollLeft > 80 && hint) { hint.style.opacity = '0'; hidden = true; }
  });
---
<main class="projects">

  {% set sortedProjects = collections.documentaryProjects | sort(false, false, "data.order") %}
  {% for project in sortedProjects %}
  <article class="project">
    <a href="{{ project.url }}">
      <div class="thumb">{% responsiveImage project.data.cover, project.data.title, "(max-width: 640px) 80vw, 50vw", 1280, "lazy" if not loop.first else "eager", "", { fetchpriority: "high" if loop.first else "auto" } %}</div>
      <div class="caption">{{ project.data.title }}{% if project.data.year %} ({{ project.data.year }}){% endif %}</div>
    </a>
  </article>
  {% endfor %}

</main>

<div class="scroll-hint">Scroll →</div>
