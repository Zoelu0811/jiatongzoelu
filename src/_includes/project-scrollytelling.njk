---
layout: layout.njk
fullScreen: true
hideFooter: true
pageStyles: |
  .gallery {
    flex: 1;
    display: flex; flex-direction: row;
    align-items: center;
    overflow-x: auto; overflow-y: hidden;
    gap: 24px;
    padding: var(--pad) 0;
    scroll-behavior: smooth;
  }
  .gallery::-webkit-scrollbar { height: 6px; }
  .gallery::-webkit-scrollbar-track { background: transparent; }
  .gallery::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
  .gallery > * { flex-shrink: 0; }
  .gallery img {
    height: 67%;
    width: auto; max-width: none;
    display: block; object-fit: contain;
  }
  .text-panel {
    width: 480px; height: 67%;
    display: flex; flex-direction: column; justify-content: flex-start;
    padding: 0 32px;
    font-size: 12px; line-height: 1.6;
    overflow-y: auto;
  }
  .text-panel .title { font-weight: 700; margin-bottom: 6px; }
  .text-panel .meta { color: var(--fg-dim); margin-bottom: 18px; }
  .text-panel p { margin-bottom: 12px; }
  .scroll-hint {
    position: fixed;
    bottom: var(--pad); right: var(--pad);
    font-size: 11px; color: var(--fg-dim);
    letter-spacing: 0.05em;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  @media (max-width: 640px) {
    .gallery {
      flex-direction: column; overflow: visible;
      padding: 24px 0; gap: 24px;
    }
    .gallery img { width: 100%; height: auto; max-width: 100%; }
    .text-panel {
      width: 100%; height: auto;
      padding: 16px 0 0;
      font-size: 12px; line-height: 1.6;
    }
    .scroll-hint { display: none; }
  }
pageScripts: |
  const gallery = document.querySelector('.gallery');
  const hint = document.querySelector('.scroll-hint');
  if (window.matchMedia('(min-width: 641px)').matches) {
    gallery.addEventListener('wheel', (e) => {
      if (e.deltaY === 0) return;
      e.preventDefault();
      gallery.scrollBy({ left: e.deltaY * 1.5, behavior: 'auto' });
    }, { passive: false });
    let hidden = false;
    gallery.addEventListener('scroll', () => {
      if (hidden) return;
      if (gallery.scrollLeft > 80) { hint.style.opacity = '0'; hidden = true; }
    });
  }
---
<main class="gallery">

  {% for img in images %}
  <img src="{{ img }}" alt="">
  {% endfor %}

  <div class="text-panel">
    <div class="title">{{ title }}</div>
    {% if year %}<div class="meta">{{ year }}</div>{% endif %}
    {{ content | safe }}
  </div>

</main>

<div class="scroll-hint">Scroll →</div>
