---
layout: layout.njk
permalink: /editorial/
title: Editorial
fullScreen: false
hideFooter: false
pageStyles: |
  .grid {
    flex: 1;
    margin: 64px auto 0;
    max-width: 1100px;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px 20px;
  }
  .item { display: flex; flex-direction: column; gap: 10px; }
  .item .thumb {
    width: 100%; aspect-ratio: 4 / 5;
    background: #ececec; overflow: hidden;
  }
  .item .thumb img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; transition: opacity 0.25s ease;
  }
  .item:hover .thumb img { opacity: 0.8; }
  .item .label { font-size: 11px; line-height: 1.6; color: var(--fg); }
  body { font-size: 12px; line-height: 1.6; }
  .logo, .header-meta { font-size: 14px; line-height: 1.9; }
  @media (max-width: 640px) {
    .grid {
      flex: none;
      align-content: start;
      margin-top: 24px;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 12px;
    }
    .logo, .header-meta { font-size: 12px; line-height: 1.6; }
    .footer { margin-top: 40px; }
  }
---
<main class="grid">
  {% set sortedEditorial = collections.editorial | sort(false, false, "data.order") %}
  {% for item in sortedEditorial %}
  <a href="{{ item.url }}" class="item">
    <div class="thumb"><img src="{{ item.data.cover }}" alt=""></div>
    <div class="label">{{ item.data.label }}</div>
  </a>
  {% endfor %}
</main>
